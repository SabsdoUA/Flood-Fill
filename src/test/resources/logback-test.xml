<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="sk.tuke.gamestudio.authentication.core.service.LoggingEmailDeliveryService" level="OFF"/>
    <logger name="sk.tuke.gamestudio.leaderboard.LeaderboardService" level="OFF"/>
    <logger name="sk.tuke.gamestudio.leaderboard.LeaderboardExceptionHandler" level="OFF"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
